rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// The Interlatch usage leaderboard (src/chronicle/leaderboard.py writes it, the dashboard's Leaderboard page reads it).
//
// Collection: players
// Document ID: the player's Firebase Auth uid (signed in with Google; GitHub allowed for later)
// Fields (all required, no others):
//   - provider: string ('google.com' | 'github.com') - how they signed in; must be the token's sign-in provider
//   - pid: string (1-128, [A-Za-z0-9_-]) - their id at that provider; must be the one in the token
//   - name: string (1-64 characters) - the name they show on the board (their choice; not their email)
//   - photo: string ('' or an https URL on Google's or GitHub's avatar host, <= 500) - their picture
//   - machine: string (8-64, [A-Za-z0-9-]) - the computer that reports for this player (one at a time)
//   - h7, h30, h90: number (>= 0, bounded, h7 <= h30 <= h90) - hours of active agent time in the last 7/30/90 days
//   - s7, s30, s90: int (>= 0, bounded, s7 <= s30 <= s90) - sessions started in those days
//   - t7, t30, t90: int (>= 0, bounded, t7 <= t30 <= t90) - tokens (input, output, cache read and write)
//   - at: timestamp - server time of the upload; must be request.time
//
// No email or other private data: the documents are public. Totals are self-reported: the rules bound them, not prove
// them.
//
// The Party's market numbers (careers/pipeline.py writes them; the dashboard reads market/current with the web key).
// Only the operator's account writes them. Derived data only: no posting's title, link or description.
//
// Collection: market
// Document ID: 'current', or the month 'YYYY-MM' (that month's last run)
// Fields (all required, no others): status ('test' | 'live'), as_of and history_since (YYYY-MM-DD), window_days (int),
//   catalog_version (int), sample (map: boards, global, japan - ints), classes (map: class id -> its counts, shares,
//   trends and top modules), unmatched (map: global, japan - the share no class fits, 0-1)
//
// Collection: careers_postings (the pipeline's history; only the operator reads it)
// Document ID: sha256("provider:token:posting id"), first 24 hex characters; the same as the id field
// Fields (all required, no others): id, company, region ('global' | 'japan'), first_seen and last_seen (YYYY-MM-DD),
//   open (bool), cls and cls2 (class ids), fit ('good' | 'partial' | 'none'), modules (<= 6 module ids), industry,
//   seniority, mapped_by, catalog_version - the mapping fields are null until the posting is mapped
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function signInProvider() {
      return request.auth.token.firebase.sign_in_provider;
    }

    // Signed in with a provider the board takes, which names the person in the token
    function isPlayerAccount() {
      return isAuthenticated()
        && signInProvider() in ['google.com', 'github.com']
        && signInProvider() in request.auth.token.firebase.identities;
    }

    function providerId() {
      return string(request.auth.token.firebase.identities[signInProvider()][0]);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function inRange(v, max) {
      return v is number && v >= 0 && v <= max;
    }

    function isCount(v, max) {
      return v is int && v >= 0 && v <= max;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidPlayer(data) {
      let fields = ['provider', 'pid', 'name', 'photo', 'machine', 'h7', 'h30', 'h90', 's7', 's30', 's90',
                    't7', 't30', 't90', 'at'];
      return hasOnlyAllowedFields(fields) && hasRequiredFields(fields)
        && data.provider == signInProvider()
        && data.pid is string && data.pid.matches('^[A-Za-z0-9_-]{1,128}$') && data.pid == providerId()
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 64
        && data.photo is string && data.photo.size() <= 500
        && (data.photo == ''
            || data.photo.matches('^https://(lh3[.]googleusercontent[.]com|avatars[.]githubusercontent[.]com)/[^\\s]+$'))
        && data.machine is string && data.machine.matches('^[A-Za-z0-9-]{8,64}$')
        // hours: parallel sessions add up, so a day may hold more than 24
        && inRange(data.h7, 7 * 24 * 50) && inRange(data.h30, 30 * 24 * 50) && inRange(data.h90, 90 * 24 * 50)
        && data.h7 <= data.h30 && data.h30 <= data.h90
        && isCount(data.s7, 7 * 5000) && isCount(data.s30, 30 * 5000) && isCount(data.s90, 90 * 5000)
        && data.s7 <= data.s30 && data.s30 <= data.s90
        && isCount(data.t7, 7 * 20000000000) && isCount(data.t30, 30 * 20000000000)
        && isCount(data.t90, 90 * 20000000000)
        && data.t7 <= data.t30 && data.t30 <= data.t90
        && data.at == request.time;
    }

    // The arena: a party's sheet (src/interlatch/sharing/arena.py writes it). Fields (all required, no others):
    //   name, photo, machine: as for players; v: int, the sheet format (2);
    //   agents: a map of the coding agents, each {level: int 1-200, tier: novice|adept|expert|master,
    //           cls: null or a track id (<= 64), attrs: {craft, data, ops, guard, arcana, lore: int}}: always the first
    //           five, and opencode from Interlatch versions that know it (sheets from older ones have no opencode);
    //   champion: which of them fights for the party;
    //   at: timestamp, the server time of the upload (request.time). No lessons, projects or titles.
    // Cheap on purpose: a request may evaluate at most 1000 expressions, and the full bounds on every attribute (as
    // before) went over it with five agents, so no sheet could be written. The values' bounds are left to the readers,
    // which clamp what they read (arena.clean_agent: level 1-200, attributes 0-100, a class that isn't a track id is
    // none). This shape fits six agents with room for one more (measured with the rules test API).
    function isValidArenaAgent(a) {
      return a.keys().toSet() == ['level', 'tier', 'cls', 'attrs'].toSet()
        && a.level is int && a.level >= 1 && a.level <= 200
        && a.tier in ['novice', 'adept', 'expert', 'master']
        && (a.cls == null || (a.cls is string && a.cls.size() <= 64))
        && a.attrs.keys().toSet() == ['craft', 'data', 'ops', 'guard', 'arcana', 'lore'].toSet()
        && a.attrs.craft is int && a.attrs.data is int && a.attrs.ops is int
        && a.attrs.guard is int && a.attrs.arcana is int && a.attrs.lore is int;
    }

    function isValidArena(data) {
      let fields = ['name', 'photo', 'machine', 'v', 'agents', 'champion', 'at'];
      let agents = ['claude', 'codex', 'copilot', 'bob', 'antigravity', 'opencode'];
      let required = ['claude', 'codex', 'copilot', 'bob', 'antigravity'];
      return hasOnlyAllowedFields(fields) && hasRequiredFields(fields)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 64
        && data.photo is string && data.photo.size() <= 500
        && (data.photo == ''
            || data.photo.matches('^https://(lh3[.]googleusercontent[.]com|avatars[.]githubusercontent[.]com)/[^\\s]+$'))
        && data.machine is string && data.machine.matches('^[A-Za-z0-9-]{8,64}$')
        && data.v == 2
        && data.champion in agents
        && data.agents is map && data.agents.keys().hasOnly(agents) && data.agents.keys().hasAll(required)
        && isValidArenaAgent(data.agents.claude) && isValidArenaAgent(data.agents.codex)
        && isValidArenaAgent(data.agents.copilot) && isValidArenaAgent(data.agents.bob)
        && isValidArenaAgent(data.agents.antigravity)
        && (!('opencode' in data.agents) || isValidArenaAgent(data.agents.opencode))
        && data.at == request.time;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /players/{userId} {
      // The board is public on purpose (anyone running Interlatch may open it); queries are capped at 100 rows.
      allow get: if true;
      allow list: if request.query.limit <= 100;

      allow create: if isOwner(userId) && isPlayerAccount() && isValidPlayer(request.resource.data);
      // provider and pid never change: the uid stays tied to the account it was made with
      allow update: if isOwner(userId) && isPlayerAccount() && isValidPlayer(request.resource.data)
        && request.resource.data.provider == resource.data.provider && request.resource.data.pid == resource.data.pid;
      // leaving the board
      allow delete: if isOwner(userId);
    }

    match /arena/{userId} {
      // Public like the board: anyone in the arena fights every other party, on their own computer.
      allow get: if true;
      allow list: if request.query.limit <= 100;
      allow create, update: if isOwner(userId) && isPlayerAccount() && isValidArena(request.resource.data);
      // leaving the arena (or the board)
      allow delete: if isOwner(userId);
    }

    // ===============================================================
    // The Party's market numbers
    // ===============================================================

    function isMarketOperator() {
      // a Firebase account id: it names the operator, it grants nothing on its own
      return isAuthenticated() && request.auth.uid == 'fHIQKiPC6tbZIuzjBivyXkEcJm83'; // gitleaks:allow
    }

    function isDay(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isNullOrText(v, max) {
      return v == null || (v is string && v.size() >= 1 && v.size() <= max);
    }

    function isValidMarket(data) {
      let fields = ['status', 'as_of', 'window_days', 'catalog_version', 'history_since', 'sample', 'classes',
                    'unmatched'];
      return hasOnlyAllowedFields(fields) && hasRequiredFields(fields)
        && data.status in ['test', 'live']
        && isDay(data.as_of) && isDay(data.history_since)
        && isCount(data.window_days, 366) && data.window_days >= 1
        && isCount(data.catalog_version, 1000)
        && data.sample is map && data.sample.keys().hasOnly(['boards', 'global', 'japan'])
        && data.sample.keys().hasAll(['boards', 'global', 'japan'])
        && isCount(data.sample.boards, 10000) && isCount(data.sample['global'], 10000000)
        && isCount(data.sample['japan'], 10000000)
        && data.classes is map && data.classes.size() <= 500
        && data.unmatched is map && data.unmatched.keys().hasOnly(['global', 'japan'])
        && data.unmatched.keys().hasAll(['global', 'japan'])
        && inRange(data.unmatched['global'], 1) && inRange(data.unmatched['japan'], 1);
    }

    function isValidPosting(id, data) {
      let fields = ['id', 'company', 'region', 'first_seen', 'last_seen', 'open', 'cls', 'cls2', 'fit', 'modules',
                    'industry', 'seniority', 'mapped_by', 'catalog_version'];
      return hasOnlyAllowedFields(fields) && hasRequiredFields(fields)
        && id.matches('^[0-9a-f]{24}$') && data.id == id
        && data.company is string && data.company.size() >= 1 && data.company.size() <= 100
        && data.region in ['global', 'japan']
        && isDay(data.first_seen) && isDay(data.last_seen)
        && data.open is bool
        && isNullOrText(data.cls, 64) && isNullOrText(data.cls2, 64)
        && (data.fit == null || data.fit in ['good', 'partial', 'none'])
        && data.modules is list && data.modules.size() <= 6
        && isNullOrText(data.industry, 60)
        && (data.seniority == null || data.seniority in ['junior', 'mid', 'senior', 'staff+', 'manager'])
        && isNullOrText(data.mapped_by, 80)
        && (data.catalog_version == null || isCount(data.catalog_version, 1000));
    }

    match /market/{doc} {
      // public: the dashboard reads it with the web key alone, and it says nothing about anyone
      allow get, list: if true;
      allow create, update: if isMarketOperator() && (doc == 'current' || doc.matches('^[0-9]{4}-[0-9]{2}$'))
        && isValidMarket(request.resource.data);
      allow delete: if isMarketOperator();
    }

    match /careers_postings/{id} {
      allow read: if isMarketOperator();
      allow create, update: if isMarketOperator() && isValidPosting(id, request.resource.data);
      allow delete: if isMarketOperator();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
