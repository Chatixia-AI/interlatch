{
  "manifest_version": 3,
  "name": "Interlatch: save web chats",
  "version": "1.0.0",
  "description": "Sends your claude.ai and ChatGPT chats to the Interlatch dashboard on this computer as you use the sites.",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": {
    "default_title": "Interlatch",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    { "matches": ["https://claude.ai/*", "https://chatgpt.com/*"], "js": ["capture.js"], "run_at": "document_idle" }
  ]
}
