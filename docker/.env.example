# Copy to .env next to compose.yaml and fill in. docs/docker.md explains each one.
# A .env from before Interlatch was renamed from Chronicle can keep its CHRONICLE_* names: compose.yaml still reads them.

# The name the hub is reached at. Its DNS must point at this server; Caddy gets the certificate for it.
INTERLATCH_DOMAIN=interlatch.example.com

# The hub's first admin: their invite is printed once, in `docker compose logs hub`.
INTERLATCH_ADMIN_EMAIL=you@example.com
INTERLATCH_ADMIN_NAME=

# The team store's database password. Long and random: openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional: the name the dashboard shows (e.g. "Platform team"), and a release to pin the image to (its version
# number; interlatch-hub has the releases from the rename on). Empty runs :latest, so `docker compose pull` updates
# the hub; set a version to choose when it does (Caddy and Postgres are pinned in compose.yaml).
INTERLATCH_HUB_NAME=
INTERLATCH_VERSION=
