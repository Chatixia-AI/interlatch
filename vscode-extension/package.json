{
  "name": "interlatch",
  "displayName": "Interlatch",
  "description": "Shared memory for your coding agents, in the Explorer: the agent sessions that read or changed the open file, and every file they worked on, from your local Interlatch.",
  "version": "0.3.0",
  "publisher": "Chatixia-AI",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chatixia-AI/interlatch",
    "directory": "vscode-extension"
  },
  "homepage": "https://interlatch.com/docs/vscode/",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude code",
    "codex",
    "copilot",
    "agents",
    "history",
    "memory"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "interlatch.fileSessions",
          "name": "Interlatch: This File",
          "icon": "media/interlatch.svg"
        },
        {
          "id": "interlatch.workspaceFiles",
          "name": "Interlatch: Files in Workspace",
          "icon": "media/interlatch.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "interlatch.refresh",
        "title": "Refresh",
        "category": "Interlatch",
        "icon": "$(refresh)"
      },
      {
        "command": "interlatch.openDashboard",
        "title": "Open Dashboard",
        "category": "Interlatch",
        "icon": "$(link-external)"
      },
      {
        "command": "interlatch.openFile",
        "title": "Open File",
        "category": "Interlatch",
        "icon": "$(go-to-file)"
      },
      {
        "command": "interlatch.openSession",
        "title": "Open Session in Interlatch",
        "category": "Interlatch",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "interlatch.refresh",
          "when": "view =~ /^interlatch\\./",
          "group": "navigation"
        },
        {
          "command": "interlatch.openDashboard",
          "when": "view == interlatch.fileSessions",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "interlatch.openSession",
          "when": "false"
        },
        {
          "command": "interlatch.openFile",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "interlatch.openFile",
          "when": "view == interlatch.workspaceFiles && viewItem == interlatchFile",
          "group": "inline"
        },
        {
          "command": "interlatch.openSession",
          "when": "view =~ /^interlatch\\./ && viewItem == interlatchSession",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Interlatch",
      "properties": {
        "interlatch.url": {
          "type": "string",
          "default": "",
          "markdownDescription": "Address of the Interlatch dashboard (`interlatch ui`). Empty: the Chronicle extension's `chronicle.url` if you set one, else `http://127.0.0.1:11524`, else `http://127.0.0.1:8765` (older installs). Set it if you changed `[server] port` in Interlatch's config."
        },
        "interlatch.includeReads": {
          "type": "boolean",
          "default": true,
          "description": "Also list sessions that only read the file, not just the ones that changed it."
        },
        "interlatch.showIgnoredFiles": {
          "type": "boolean",
          "default": false,
          "description": "Also show files git ignores (screenshots, build output, caches) in Interlatch: Files in Workspace."
        }
      }
    }
  }
}
